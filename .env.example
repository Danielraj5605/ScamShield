# Copy to .env (never commit .env). Real environment variables override these values.

# Server
SS_HOST=127.0.0.1          # bind to localhost; view the UI through an SSH tunnel
SS_PORT=8000
SS_MAX_CHARS=2000
SS_RATE_PER_MIN=120
SS_LOG_LEVEL=INFO

# Privacy: message text is never logged. Opt-in feedback stores only a salted hash and needs a salt:
#   python3 -c "import secrets;print(secrets.token_hex(16))"
SS_PRIVACY_MODE=1
SS_FEEDBACK_SALT=
SS_DB_PATH=./feedback.db

# Reproducibility / safety
SS_SEED=42
SS_ALLOW_ARCH_MISMATCH=0   # refuse to load models trained on a different CPU architecture

# Optional GenAI explanations through a free OpenAI-compatible API (leave blank to use built-in explanations).
# Only the scrubbed message (links/phones/amounts/numbers replaced) and the detected warning signs are sent.
# Examples (check each provider's current free tier and model names):
#   Groq:   SS_LLM_BASE_URL=https://api.groq.com/openai/v1                        SS_LLM_MODEL=llama-3.1-8b-instant
#   Gemini: SS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  SS_LLM_MODEL=gemini-2.0-flash
SS_LLM_BASE_URL=
SS_LLM_API_KEY=
SS_LLM_MODEL=
SS_LLM_TIMEOUT=20
